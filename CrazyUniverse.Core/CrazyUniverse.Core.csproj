<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="AnimalNames.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AnimalNames.resx</DependentUpon>
    </Compile>
    <Compile Update="AnimalSounds.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AnimalSounds.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="AnimalNames.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>AnimalNames.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="AnimalSounds.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>AnimalSounds.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
