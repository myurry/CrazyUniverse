<Window x:Class="CrazyUniverse.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Crazy Universe - Animal Sanctuary" Height="620" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Tabs for Repositories, List, and Add Controls -->
        <DockPanel Grid.Column="0">
            <TextBlock Text="Sanctuary Repositories" FontWeight="Bold" FontSize="14" DockPanel.Dock="Top" Margin="0,0,0,5"/>

            <!-- 4 Tabs for Horses, Cows, Monkeys, Birds -->
            <TabControl x:Name="AnimalTabControl" DockPanel.Dock="Top" Height="30" Margin="0,0,0,5" SelectionChanged="AnimalTabControl_SelectionChanged">
                <TabItem Header="Horses" Tag="Horse"/>
                <TabItem Header="Cows" Tag="Cow"/>
                <TabItem Header="Monkeys" Tag="Monkey"/>
                <TabItem Header="Birds" Tag="Bird"/>
            </TabControl>

            <!-- Add Animal Panel at Bottom -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock Text="Add New Animal" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Type:"/>
                    <ComboBox x:Name="CmbAnimalType" Grid.Row="0" Grid.Column="1" Margin="2" SelectedIndex="0" SelectionChanged="CmbAnimalType_SelectionChanged">
                        <ComboBoxItem Content="Horse"/>
                        <ComboBoxItem Content="Cow"/>
                        <ComboBoxItem Content="Monkey"/>
                        <ComboBoxItem Content="Bird"/>
                    </ComboBox>

                    <Label Grid.Row="1" Grid.Column="0" Content="Name:"/>
                    <TextBox x:Name="TxtName" Grid.Row="1" Grid.Column="1" Margin="2,2,2,0" VerticalContentAlignment="Center" Height="22" VerticalAlignment="Top"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Energy (0-100):"/>
                    <TextBox x:Name="TxtEnergy" Grid.Row="2" Grid.Column="1" Margin="2" VerticalContentAlignment="Center" Text="50"/>

                    <Button x:Name="BtnAdd" Grid.Row="3" Grid.ColumnSpan="2" Content="Add Animal" Margin="0,8,0,0" Padding="5" Click="BtnAdd_Click"/>
                </Grid>
            </StackPanel>

            <!-- Animal List with Checkboxes for Simulation -->
            <ListView x:Name="LstAnimals" 
                      ItemsSource="{Binding DisplayedAnimals}" 
                      SelectedItem="{Binding SelectedAnimal, Mode=TwoWay}"
                      SelectionChanged="LstAnimals_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <CheckBox IsChecked="{Binding IsSelectedForSimulation, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Select for Vol.3 Simulation"/>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EnergyLevel, StringFormat='(Energy: {0})'}" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#FFE0E0E0"/>

        <!-- Right Column: Details, Actions, Simulation Controls, and Log -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Details Header -->
            <TextBlock Grid.Row="0" Text="Selected Animal Actions &amp; Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <!-- Action Buttons Panel -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <Button x:Name="BtnMakeSound" Content="Make Sound" Click="BtnMakeSound_Click" Margin="0,0,8,8" Padding="8,5"/>
                <Button x:Name="BtnCrazyAction" Content="⚡ Crazy Action!" Click="BtnCrazyAction_Click" Margin="0,0,8,8" Padding="8,5" Background="#FFFFE0E0"/>
                <Button x:Name="BtnRemove" Content="Remove Animal" Click="BtnRemove_Click" Margin="0,0,8,8" Padding="8,5" Background="#FFF0F0F0"/>
            </WrapPanel>

            <!-- Expander for Special Capabilities -->
            <Expander Grid.Row="2" x:Name="ExpSpecialAbilities" Header="Special Interface Abilities (IClimbable / IFlyable)" IsExpanded="False" Margin="0,0,0,10" Padding="5">
                <StackPanel Margin="5">
                    <TextBlock x:Name="TxtAbilityStatus" Text="Select a Monkey or a Bird to test interface abilities." FontStyle="Italic" Margin="0,0,0,5"/>
                    <Button x:Name="BtnTriggerAbility" Content="Trigger Interface Ability" Click="BtnTriggerAbility_Click" Padding="6,4" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- Vol.3 CPU Simulation Panel -->
            <Expander Grid.Row="3" Header="Vol.3 CPU Simulations (Sequential &amp; Parallel)" IsExpanded="True" Margin="0,0,0,10" Padding="5">
                <StackPanel Margin="5">
                    <TextBlock Text="Workload Size (Iterations):" FontWeight="Bold" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbWorkload" SelectedIndex="2" Margin="0,0,0,8" Height="24" SelectionChanged="CmbWorkload_SelectionChanged">
                        <ComboBoxItem Content="Quick (10M)" Tag="10000000"/>
                        <ComboBoxItem Content="Medium (100M)" Tag="100000000"/>
                        <ComboBoxItem Content="Heavy / >5s (300M)" Tag="300000000"/>
                        <ComboBoxItem Content="Massive (500M)" Tag="500000000"/>
                    </ComboBox>

                    <WrapPanel>
                        <Button x:Name="BtnRunSequential" Content="Run Sequential" Margin="0,0,8,5" Padding="8,5" Background="#E3F2FD" Click="BtnRunSequential_Click"/>
                        <Button x:Name="BtnRunParallel" Content="Run Parallel" Margin="0,0,8,5" Padding="8,5" Background="#E8F5E9" Click="BtnRunParallel_Click"/>
                        <Button x:Name="BtnCancelSimulation" Content="Cancel" Margin="0,0,8,5" Padding="8,5" Background="#FFEBEE" Click="BtnCancelSimulation_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <!-- Log / Output Area -->
            <DockPanel Grid.Row="4">
                <TextBlock Text="Activity Log &amp; Reports:" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtLog" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FFF9F9F9"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>